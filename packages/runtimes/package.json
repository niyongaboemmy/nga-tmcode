{
  "name": "@nga/runtimes",
  "private": true,
  "version": "2026.10.3",
  "type": "module",
  "license": "UNLICENSED",
  "description": "NGA Runtime Catalog: languages, toolchains, project kinds, detection, test-report parsing and starter projects (no React, no DOM)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts"
    },
    "./dist": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalog.json": "./dist/catalog.json",
    "./starters.json": "./dist/starters.json"
  },
  "files": [
    "src",
    "dist",
    "starters",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run --root ../.. packages/runtimes",
    "typecheck": "tsc -p .",
    "verify-starters": "node scripts/verify-starters.mjs"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
