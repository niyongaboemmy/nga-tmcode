# /etc/nginx/sites-available/preview on the APP HOST: the public preview origin.
# PREVIEW_HOST must be a SEPARATE SITE (preview.<ip-with-dashes>.sslip.io or <name>.duckdns.org),
# never a subdomain of amashuri.com: .amashuri.com cookies would reach student code.
# Same as Task Mentor's deploy/nginx-preview.conf.example.
# Only /p/<id>/<token>/... is forwarded (signed by Task Mentor, checked by tm-judge) over the
# WireGuard tunnel; nothing else of tm-judge is reachable from here. certbot --nginx adds TLS.
map $http_upgrade $preview_connection {
  default upgrade;
  ""      close;
}

server {
  listen 80;
  server_name PREVIEW_HOST;   # e.g. preview.13-48-1-2.sslip.io or nga-preview.duckdns.org

  client_max_body_size 10m;

  location /p/ {
    proxy_pass http://10.66.0.2:5010;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $preview_connection;
    proxy_buffering off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
  }

  location / {
    return 404;
  }
}
