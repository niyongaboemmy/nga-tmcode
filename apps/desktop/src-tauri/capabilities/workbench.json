{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "workbench",
  "description": "The TMCode workbench (local UI). Preview webviews load student code and get no permissions at all.",
  "webviews": [
    "workbench"
  ],
  "permissions": [
    "core:default",
    "log:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-is-maximized",
    "store:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "allow-app-info",
    "allow-set-native-theme",
    "allow-ws-open",
    "allow-ws-reopen",
    "allow-ws-read-dir",
    "allow-ws-read-file",
    "allow-ws-copy",
    "allow-ws-read-base64",
    "allow-open-external",
    "allow-ws-write-file",
    "allow-ws-create-file",
    "allow-ws-create-dir",
    "allow-ws-rename",
    "allow-ws-remove",
    "allow-ws-trash",
    "allow-pty-spawn",
    "allow-pty-write",
    "allow-pty-resize",
    "allow-pty-kill",
    "allow-toolchains-detect",
    "allow-run-start",
    "allow-run-input",
    "allow-run-kill",
    "allow-toolchains-candidates",
    "allow-toolchains-select",
    "allow-debug-probe",
    "allow-debug-install",
    "allow-debug-prepare",
    "allow-debug-start",
    "allow-debug-send",
    "allow-debug-stop",
    "allow-debug-run-in-terminal",
    "allow-debug-policy",
    "allow-preview-publish",
    "allow-api-request",
    "allow-proc-run",
    "allow-proc-kill",
    "allow-exam-device",
    "allow-exam-workspace",
    "allow-journal-load",
    "allow-journal-append",
    "allow-journal-mark-synced",
    "deep-link:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://taskmentor-api.amashuri.com/api/tmcode/*"
        },
        {
          "url": "http://localhost:*/api/tmcode/*"
        },
        {
          "url": "http://127.0.0.1:*/api/tmcode/*"
        }
      ]
    },
    "allow-ws-open-file",
    "allow-ws-open-path",
    "allow-ws-reveal",
    "core:window:allow-set-title",
    "allow-update-check",
    "allow-update-install",
    "allow-take-pending-open",
    "allow-ext-fetch",
    "allow-ext-list",
    "allow-ext-install",
    "allow-ext-uninstall",
    "allow-ext-read-file",
    "allow-ext-install-vsix",
    "allow-exthost-start",
    "allow-exthost-send",
    "allow-exthost-stop",
    "allow-exthost-policy",
    "allow-exthost-secret",
    "allow-webview-publish",
    "allow-webview-dispose",
    "allow-auth-sign-in",
    "allow-auth-cancel",
    "allow-auth-status",
    "allow-auth-sign-out",
    "allow-tm-api",
    "allow-proj-scan",
    "allow-proj-read-blob",
    "allow-proj-write-blob",
    "allow-proj-new-folder",
    "allow-proj-use-projects-folder",
    "allow-git-info",
    "allow-git-status",
    "allow-git-show",
    "allow-git-stage",
    "allow-git-unstage",
    "allow-git-discard",
    "allow-git-commit",
    "allow-git-branches",
    "allow-git-checkout",
    "allow-git-log",
    "allow-git-init",
    "allow-git-stash",
    "allow-git-check-ignore",
    "allow-git-set-identity",
    "allow-git-remote",
    "allow-git-cancel",
    "allow-git-pick-clone-parent",
    "allow-git-clone",
    "allow-github-sign-in",
    "allow-github-user",
    "allow-github-sign-out",
    "allow-github-repos",
    "allow-git-open-url"
  ]
}
