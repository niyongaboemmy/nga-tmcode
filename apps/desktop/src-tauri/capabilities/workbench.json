{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "workbench",
  "description": "The TMCode workbench (local UI). Preview webviews load student code and get no permissions at all.",
  "webviews": [
    "workbench"
  ],
  "permissions": [
    "core:default",
    "log:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "store:default",
    "allow-app-info",
    "allow-set-native-theme",
    "allow-ws-open",
    "allow-ws-reopen",
    "allow-ws-read-dir",
    "allow-ws-read-file",
    "allow-ws-read-base64",
    "allow-open-external",
    "allow-ws-write-file",
    "allow-ws-create-file",
    "allow-ws-create-dir",
    "allow-ws-rename",
    "allow-ws-remove",
    "allow-pty-spawn",
    "allow-pty-write",
    "allow-pty-resize",
    "allow-pty-kill",
    "allow-toolchains-detect",
    "allow-run-start",
    "allow-run-input",
    "allow-run-kill",
    "allow-preview-publish",
    "allow-exam-device",
    "allow-exam-workspace",
    "allow-journal-load",
    "allow-journal-append",
    "allow-journal-mark-synced",
    "deep-link:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://taskmentor-api.amashuri.com/api/tmcode/*"
        },
        {
          "url": "http://localhost:*/api/tmcode/*"
        },
        {
          "url": "http://127.0.0.1:*/api/tmcode/*"
        }
      ]
    },
    "allow-ws-open-file",
    "allow-ws-open-path",
    "allow-ws-reveal",
    "core:window:allow-set-title",
    "allow-update-check",
    "allow-update-install",
    "allow-take-pending-open"
  ]
}
